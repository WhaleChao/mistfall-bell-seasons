{"schema_version":1,"id":"y2_summer_forge_promise_dialogue","title":"鍛爐的約定","start_node":"start","characters":["hero","soren"],"nodes":[{"id":"start","type":"line","speaker":"soren","text":"封印只是音，還需要能承受它的鐘舌。把農場撐到六級，升級一件工具；讓我看看你的手是否懂得重量。","next":"answer"},{"id":"answer","type":"choice","options":[{"text":"我們一起重鑄它。","next":"accept"},{"text":"等我的工坊準備好。","next":"later"}]},{"id":"accept","type":"action","actions":[{"type":"quest","quest_id":"y2_summer_forge_promise_quest","state":"active"}],"next":"end"},{"id":"later","type":"line","speaker":"soren","text":"鐵不怕等，只怕火候錯。","next":"end"},{"id":"end","type":"end"}]}
