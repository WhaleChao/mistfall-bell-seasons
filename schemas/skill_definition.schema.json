{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelrpg.local/schemas/skill_definition.schema.json",
  "title": "SkillDefinition",
  "type": "object",
  "required": ["schema_version", "id", "display_name", "description", "cooldown", "power_multiplier", "range"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "display_name": {"type": "string", "minLength": 1}, "description": {"type": "string"}, "icon": {"type": "string"},
    "cooldown": {"type": "number", "minimum": 0}, "power_multiplier": {"type": "number", "minimum": 0}, "range": {"type": "number", "minimum": 0},
    "effects": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": false
}
