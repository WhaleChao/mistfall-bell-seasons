{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/procedural_request_template.schema.json", "title": "ProceduralRequestTemplate catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "type", "target_pool", "count_range", "reward_range", "duration_days"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "display_name": {"type": "string"}, "type": {"enum": ["harvest", "delivery", "monster", "fish", "animal", "social"]}, "target_pool": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "count_range": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}], "items": false}, "reward_range": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false}, "duration_days": {"type": "integer", "minimum": 1, "maximum": 14}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 6, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
