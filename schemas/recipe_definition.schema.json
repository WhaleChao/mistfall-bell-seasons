{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/recipe_definition.schema.json", "title": "RecipeDefinition catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "season", "ingredients", "energy"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "display_name": {"type": "string"}, "season": {"enum": ["spring", "summer", "autumn", "winter"]}, "ingredients": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "integer", "minimum": 1}}, "energy": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 40, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
