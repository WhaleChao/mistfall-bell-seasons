{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/npc_schedule.schema.json", "title": "NPCSchedule catalog",
  "$defs": {"slot": {"type": "object", "required": ["from", "to", "map", "marker"], "properties": {"from": {"type": "integer", "minimum": 0, "maximum": 1439}, "to": {"type": "integer", "minimum": 1, "maximum": 1440}, "map": {"type": "string"}, "marker": {"type": "string"}}, "additionalProperties": false}, "definition": {"type": "object", "required": ["id", "display_name", "romance_candidate", "weekday"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "display_name": {"type": "string"}, "romance_candidate": {"type": "boolean"}, "weekday": {"type": "array", "items": {"$ref": "#/$defs/slot"}}, "rain": {"type": "array", "items": {"$ref": "#/$defs/slot"}}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
