{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelrpg.local/schemas/save_game.schema.json",
  "title": "SaveGame v3",
  "type": "object",
  "required": ["schema_version", "player", "map", "flags", "quests", "inventory", "calendar", "weather", "farm", "relationships", "marriage", "child", "festivals", "dungeon", "story", "procedural", "tools", "economy", "achievements", "lifetime_stats", "settings"],
  "properties": {
    "schema_version": {"const": 3},
    "player": {"type": "object", "required": ["name", "appearance", "position", "stats", "coins"], "properties": {"name": {"type": "string", "minLength": 1}, "appearance": {"type": "object"}, "position": {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "items": false}, "stats": {"type": "object"}, "coins": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "map": {"type": "string"},
    "flags": {"type": "object"},
    "quests": {"type": "object", "additionalProperties": {"type": "string"}},
    "inventory": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "calendar": {"type": "object", "required": ["year", "season_index", "season", "day", "minute_of_day", "speed_mode"], "properties": {"year": {"type": "integer", "minimum": 1}, "season_index": {"type": "integer", "minimum": 0, "maximum": 3}, "season": {"enum": ["spring", "summer", "autumn", "winter"]}, "day": {"type": "integer", "minimum": 1, "maximum": 30}, "minute_of_day": {"type": "integer", "minimum": 360, "maximum": 1440}, "speed_mode": {"enum": ["fast", "standard", "relaxed"]}}, "additionalProperties": false},
    "weather": {"type": "object", "required": ["current", "forecast"], "properties": {"current": {"type": "string"}, "forecast": {"type": "object"}}, "additionalProperties": false},
    "farm": {"type": "object", "required": ["rank", "plots", "seed_stock", "produce", "animals", "greenhouse_unlocked", "unlocked_upgrades"], "properties": {"rank": {"type": "integer", "minimum": 1, "maximum": 10}, "plots": {"type": "object"}, "seed_stock": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "produce": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "animals": {"type": "array", "items": {"type": "object"}}, "greenhouse_unlocked": {"type": "boolean"}, "unlocked_upgrades": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
    "relationships": {"type": "object", "additionalProperties": {"type": "object", "required": ["friendship", "romance", "dating", "events_seen"], "properties": {"friendship": {"type": "integer", "minimum": 0, "maximum": 2500}, "romance": {"type": "integer", "minimum": 0, "maximum": 2500}, "dating": {"type": "boolean"}, "events_seen": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
    "marriage": {"type": "object", "required": ["spouse_id", "married_absolute_day", "family_talk_seen"], "properties": {"spouse_id": {"type": "string"}, "married_absolute_day": {"type": "integer", "minimum": 0}, "family_talk_seen": {"type": "boolean"}}, "additionalProperties": false},
    "child": {"type": "object", "required": ["exists", "name", "born_absolute_day", "stage"], "properties": {"exists": {"type": "boolean"}, "name": {"type": "string"}, "born_absolute_day": {"type": "integer", "minimum": 0}, "stage": {"enum": ["none", "baby", "toddler", "child", "teen"]}}, "additionalProperties": false},
    "festivals": {"type": "object"},
    "dungeon": {"type": "object"},
    "story": {"type": "object"},
    "procedural": {"type": "object"},
    "tools": {"type": "object", "required": ["stamina", "tool_levels", "equipped_tool"], "properties": {"stamina": {"type": "integer", "minimum": 0, "maximum": 100}, "tool_levels": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 4}}, "equipped_tool": {"type": "string"}}, "additionalProperties": false},
    "economy": {"type": "object", "required": ["shipping_bin", "total_earned", "total_spent", "purchase_counts", "last_shipping_total"], "properties": {"shipping_bin": {"type": "object"}, "total_earned": {"type": "integer", "minimum": 0}, "total_spent": {"type": "integer", "minimum": 0}, "purchase_counts": {"type": "object"}, "last_shipping_total": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "achievements": {"type": "object", "required": ["unlocked"], "properties": {"unlocked": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}}, "additionalProperties": false},
    "lifetime_stats": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "settings": {"type": "object", "required": ["master_volume", "text_speed", "fullscreen", "control_prompts"], "properties": {"master_volume": {"type": "number", "minimum": 0, "maximum": 1}, "text_speed": {"type": "number", "minimum": 0.25, "maximum": 3}, "fullscreen": {"type": "boolean"}, "control_prompts": {"enum": ["auto", "keyboard", "gamepad"]}}, "additionalProperties": false},
    "saved_at_unix": {"type": "integer"}
  },
  "additionalProperties": false
}
