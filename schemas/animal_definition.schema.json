{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/animal_definition.schema.json", "title": "AnimalDefinition catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "purchase_price", "product_id", "product_interval_days", "gestation_days"], "properties": {"id": {"enum": ["chicken", "cow"]}, "display_name": {"type": "string"}, "purchase_price": {"type": "integer", "minimum": 1}, "product_id": {"enum": ["egg", "milk"]}, "product_interval_days": {"type": "integer", "minimum": 1}, "gestation_days": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
