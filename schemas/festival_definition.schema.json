{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/festival_definition.schema.json", "title": "FestivalDefinition catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "season", "day", "start_minute", "end_minute", "map", "participation_reward", "activity", "challenge_target", "year_variants"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "display_name": {"type": "string"}, "season": {"enum": ["spring", "summer", "autumn", "winter"]}, "day": {"enum": [8, 18, 28]}, "start_minute": {"type": "integer", "minimum": 360, "maximum": 1439}, "end_minute": {"type": "integer", "minimum": 361, "maximum": 1440}, "map": {"type": "string"}, "participation_reward": {"type": "integer", "minimum": 0}, "activity": {"enum": ["timing", "rhythm", "showcase", "cooking"]}, "challenge_target": {"type": "integer", "minimum": 35, "maximum": 95}, "year_variants": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "string"}}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 12, "maxItems": 12, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
