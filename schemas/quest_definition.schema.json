{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelrpg.local/schemas/quest_definition.schema.json",
  "title": "QuestDefinition",
  "type": "object",
  "required": ["schema_version", "id", "title", "summary", "prerequisites", "objectives", "rewards", "dialogue_refs"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "title": {"type": "string", "minLength": 1}, "summary": {"type": "string"},
    "prerequisites": {"type": "array", "items": {"type": "object"}},
    "objectives": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "target", "count"], "properties": {"id": {"type": "string"}, "type": {"enum": ["defeat", "collect", "talk", "reach", "flag"]}, "target": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "rewards": {"type": "array", "items": {"type": "object", "required": ["type", "id", "count"], "properties": {"type": {"enum": ["item", "skill", "currency"]}, "id": {"type": "string"}, "count": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
    "dialogue_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "additionalProperties": false
}
