{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/fish_definition.schema.json", "title": "FishDefinition catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "seasons", "locations", "hours", "weather", "sell_price"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "display_name": {"type": "string"}, "seasons": {"type": "array", "items": {"enum": ["spring", "summer", "autumn", "winter"]}}, "locations": {"type": "array", "items": {"type": "string"}}, "hours": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0, "maximum": 23}, {"type": "integer", "minimum": 1, "maximum": 24}], "items": false}, "weather": {"type": "array", "items": {"type": "string"}}, "sell_price": {"type": "integer", "minimum": 1}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 12, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
