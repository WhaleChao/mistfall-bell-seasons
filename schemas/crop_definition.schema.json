{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelrpg.local/schemas/crop_definition.schema.json",
  "title": "CropDefinition catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "seasons", "growth_days", "regrow_days", "category", "seed_price", "sell_price"], "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}, "display_name": {"type": "string"}, "seasons": {"type": "array", "minItems": 1, "items": {"enum": ["spring", "summer", "autumn", "winter"]}, "uniqueItems": true}, "growth_days": {"type": "integer", "minimum": 1, "maximum": 30}, "regrow_days": {"type": "integer", "minimum": 0, "maximum": 15}, "category": {"enum": ["fast", "medium", "long", "regrow", "rare"]}, "seed_price": {"type": "integer", "minimum": 1}, "sell_price": {"type": "integer", "minimum": 1}, "cross_season": {"type": "boolean"}, "color": {"type": "string", "pattern": "^[a-fA-F0-9]{6}$"}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 48, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
