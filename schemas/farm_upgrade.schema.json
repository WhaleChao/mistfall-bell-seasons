{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://pixelrpg.local/schemas/farm_upgrade.schema.json", "title": "FarmUpgrade catalog",
  "$defs": {"definition": {"type": "object", "required": ["id", "display_name", "rank", "cost", "materials", "unlocks"], "properties": {"id": {"type": "string", "pattern": "^farm_rank_[0-9]+$"}, "display_name": {"type": "string"}, "rank": {"type": "integer", "minimum": 1, "maximum": 10}, "cost": {"type": "integer", "minimum": 0}, "materials": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}, "unlocks": {"type": "array", "items": {"type": "string"}}, "unlocks_greenhouse": {"type": "boolean"}}, "additionalProperties": false}},
  "oneOf": [{"$ref": "#/$defs/definition"}, {"type": "object", "required": ["schema_version", "definitions"], "properties": {"schema_version": {"const": 1}, "definitions": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"$ref": "#/$defs/definition"}}}, "additionalProperties": false}]
}
